{
  "name": "splitpay",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts vite.config.ts playwright.config.ts",
    "screenshots": "npm run build && node scripts/capture-screenshots.mjs",
    "hosting:local": "npm run build && firebase emulators:start --only hosting --project demo-splitpay",
    "deploy": "firebase deploy --only hosting"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^0.577.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.7",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
